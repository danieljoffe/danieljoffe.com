{
  "name": "@danieljoffe.com/root",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/root/src",
  "projectType": "application",
  "tags": ["scope:root", "type:app"],
  "targets": {
    "generate-search-index": {
      "command": "tsx scripts/generate-search-index.ts",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "dependsOn": ["generate-search-index"],
      "options": {
        "command": "next build --webpack"
      }
    }
  }
}
