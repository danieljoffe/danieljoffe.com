{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "audit-api",
  "sourceRoot": "apps/audit-api",
  "projectType": "application",
  "tags": ["scope:audit", "type:app", "platform:python"],
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --package audit-api uvicorn app.main:app --reload --port 8001",
        "cwd": "apps/audit-api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "dependsOn": [],
      "options": {
        "command": "uv run --package audit-api pytest -v",
        "cwd": "apps/audit-api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/pyproject.toml",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "options": {
        "command": "uv run --package audit-api ruff check .",
        "cwd": "apps/audit-api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock"
      ],
      "options": {
        "command": "uv run --package audit-api mypy app/",
        "cwd": "apps/audit-api"
      }
    },
    "docker:build": {
      "// dependsOn": "Override @nx/docker plugin's inferred dependsOn:['build','^build']. This is a Python app — no JS build target — so the inferred deps would error 'Cannot find configuration for task audit-api:build' on invocation.",
      "dependsOn": []
    }
  }
}
