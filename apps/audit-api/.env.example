# Supabase — service role only (server-side). Wired in Phase 1 Step 2.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between Next.js proxy routes and this API (x-api-key header).
# Generate: `openssl rand -hex 32`
AUDIT_API_KEY=

# Must match the admin session secret used by the Next.js app so JWTs verify.
ADMIN_SESSION_SECRET=

# Host header allowlist — comma-separated. Include Railway public domain and
# any private networking hostnames the Next.js proxy will call.
# Example: audit-api.up.railway.app,audit-api.railway.internal
ALLOWED_HOSTS=*

# --- Sentry (optional locally, required in prod) ---
# Empty DSN = no-op. Scan worker crashes and request exceptions only surface
# in Railway logs when Sentry is off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
