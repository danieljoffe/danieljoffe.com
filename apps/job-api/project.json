{
  "name": "job-api",
  "sourceRoot": "apps/job-api",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/job-api && poetry run uvicorn app.main:app --reload --port 8000",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/job-api && poetry run uvicorn app.main:app --reload --port 8000",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/job-api && poetry run pytest -v",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/job-api && poetry run ruff check .",
        "cwd": "{workspaceRoot}"
      }
    },
    "mypy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/job-api && poetry run mypy app/",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
