{
  "name": "@danieljoffe.com/shared-ui",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@danieljoffe.com/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./Badge": {
      "@danieljoffe.com/source": "./src/lib/Badge.tsx",
      "types": "./dist/lib/Badge.d.ts",
      "default": "./src/lib/Badge.tsx"
    },
    "./Heading": {
      "@danieljoffe.com/source": "./src/lib/Heading.tsx",
      "types": "./dist/lib/Heading.d.ts",
      "default": "./src/lib/Heading.tsx"
    },
    "./Skeleton": {
      "@danieljoffe.com/source": "./src/lib/Skeleton.tsx",
      "types": "./dist/lib/Skeleton.d.ts",
      "default": "./src/lib/Skeleton.tsx"
    },
    "./Text": {
      "@danieljoffe.com/source": "./src/lib/Text.tsx",
      "types": "./dist/lib/Text.d.ts",
      "default": "./src/lib/Text.tsx"
    },
    "./styles/theme.css": "./src/styles/theme.css"
  }
}
